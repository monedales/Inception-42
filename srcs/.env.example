# =============================================================================
# .env.example — template for the real .env (which is git-ignored)
# Copy this file to .env and fill real values. Passwords live in ../secrets/
# =============================================================================

# ==== DOMAIN =================================================================
DOMAIN_NAME="your-login.42.fr"

# ==== MARIADB ================================================================
MYSQL_DATABASE="database_name_here"
MYSQL_USER="db_user_here"
# MYSQL root password      -> secrets/db_root_password.txt
# MYSQL wp_user password   -> secrets/db_password.txt

# ==== WORDPRESS ==============================================================
WP_TITLE="site_title_here"
WP_URL="your-login.42.fr"

# Admin user (MUST NOT contain 'admin' / 'Admin')
WP_ADMIN_USER="admin_username_here"
WP_ADMIN_EMAIL="admin@student.fr"
# WP admin password        -> secrets/wp_admin_password.txt

# Second (regular) user
WP_USER="regular_username_here"
WP_USER_EMAIL="user@student.fr"
WP_USER_ROLE="author"
# WP user password         -> secrets/wp_user_password.txt

# ==== SSL / CERTIFICATE ======================================================
CERT_COUNTRY="BR"
CERT_STATE="your_state_here"
CERT_CITY="your_city_here"
CERT_ORG="42"
CERT_UNIT="42"
CERT_CN="your-login.42.fr"
